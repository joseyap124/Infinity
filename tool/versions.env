# Versi dikunci supaya build ulang kapan pun hasilnya sama.
# Kosongkan FLUTTER_VERSION untuk memakai stable terbaru (tidak disarankan).
# Paket ditulis "nama:versi"; dependensi tidak langsung dikunci lewat
# tool/pubspec.lock.
FLUTTER_VERSION=
PACKAGES=intl flutter_secure_storage local_auth flutter_local_notifications timezone home_widget image_picker path_provider archive cryptography google_mlkit_text_recognition
