<?xml version="1.0" encoding="utf-8"?>
<!-- Pintasan ikon (tahan ikon Infinity di layar utama). Memakai jalur yang sama
     dengan tombol widget: aksi LAUNCH milik home_widget + URI infinity://add. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="catat_pengeluaran"
        android:enabled="true"
        android:icon="@drawable/sc_expense"
        android:shortcutShortLabel="@string/sc_expense_short"
        android:shortcutLongLabel="@string/sc_expense_long">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="infinity://add?type=expense"
            android:targetPackage="com.jose.infinity"
            android:targetClass="com.jose.infinity.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="catat_pemasukan"
        android:enabled="true"
        android:icon="@drawable/sc_income"
        android:shortcutShortLabel="@string/sc_income_short"
        android:shortcutLongLabel="@string/sc_income_long">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="infinity://add?type=income"
            android:targetPackage="com.jose.infinity"
            android:targetClass="com.jose.infinity.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="catat_transfer"
        android:enabled="true"
        android:icon="@drawable/sc_transfer"
        android:shortcutShortLabel="@string/sc_transfer_short"
        android:shortcutLongLabel="@string/sc_transfer_long">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="infinity://add?type=transfer"
            android:targetPackage="com.jose.infinity"
            android:targetClass="com.jose.infinity.MainActivity" />
    </shortcut>
</shortcuts>
