<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2x2 bersih (v5.11): tanpa maskot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/infinity_widget_bg_clean"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
            android:id="@+id/cm_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_clean_muted"
            android:textSize="11sp" />

    <TextView
            android:id="@+id/cm_safe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_clean_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/cm_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/infinity_widget_bar_acc"
            android:visibility="visible" />
        <ProgressBar
            android:id="@+id/cm_bar_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/infinity_widget_bar_out"
            android:visibility="gone" />

    <TextView
            android:id="@+id/cm_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_clean_acc"
            android:textSize="11sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/cm_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_clean_muted"
            android:textSize="11sp" />
</LinearLayout>
