<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x2 bersih (v5.11): tanpa maskot, bar sisa jatah, tombol Keluar / Masuk / Transfer.
     Warna dari resource sehingga mengikuti mode terang/gelap HP. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/infinity_widget_bg_clean"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/c_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_clean_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/c_safe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_clean_ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/c_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/infinity_widget_bar_acc"
            android:visibility="visible" />
        <ProgressBar
            android:id="@+id/c_bar_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/infinity_widget_bar_out"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/c_perday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/w_clean_acc"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/c_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/w_clean_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/c_btn_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/infinity_widget_cbtn_out_soft"
            android:gravity="center"
            android:maxLines="1"
            android:text="− Keluar"
            android:textColor="@color/w_clean_out"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/c_btn_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/infinity_widget_cbtn_acc_soft"
            android:gravity="center"
            android:maxLines="1"
            android:text="+ Masuk"
            android:textColor="@color/w_clean_acc"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/c_btn_transfer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/infinity_widget_cbtn_neutral"
            android:gravity="center"
            android:maxLines="1"
            android:text="⇄ Transfer"
            android:textColor="@color/w_clean_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
